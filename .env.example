# Required. Use a dedicated OpenAI *project* key with a budget limit, not a
# shared account key — otherwise any other project on the account can drain the
# quota and the site's agent stops answering.
OPENAI_API_KEY=sk-...

# ── Spend controls (defaults shown; all optional) ────────────────────────────
# CHAT_MODEL=gpt-4o-mini
# TOP_K=2                    # retrieved chunks sent to the model
# MAX_TOKENS=300             # cap on answer length
# MAX_MESSAGE_LEN=500        # longer questions are rejected before any API call
# IP_DAILY_LIMIT=30          # LLM answers per visitor IP per day
# GLOBAL_DAILY_LIMIT=500     # hard ceiling on LLM answers per day, all visitors
# CACHE_TTL_SECONDS=604800   # repeated questions are served from cache
# CACHE_MAX_ENTRIES=500

# ── Retrieval ────────────────────────────────────────────────────────────────
# EMBEDDINGS_BACKEND=local   # 'local' (ONNX, free) or 'openai'
# EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDINGS_THREADS=1
# FAQ_SHORTCUT_SIMILARITY=0.80   # above this, answer from the FAQ without an LLM call
# MIN_CONTEXT_SIMILARITY=0.30    # below this, a chunk is noise and is dropped

# ── Access ───────────────────────────────────────────────────────────────────
# REQUIRE_ORIGIN=true
# ALLOWED_ORIGINS=https://vegman.dev,https://www.vegman.dev,https://natavegman.github.io

# Changing EMBEDDINGS_BACKEND or EMBEDDINGS_MODEL requires rebuilding the index:
#   venv/bin/python backend/build_index.py
